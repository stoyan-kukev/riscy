// ============================================================================
// RISCY PARSER STRESS TEST
// ============================================================================

// 1. Top-Level Declarations, Builtins, and Multiline Strings
pub const std = @import("std");

pub const welcome_msg = 
    \\ Welcome to the Riscy Language!
    \\ This string should span multiple lines
    \\ and not break the tokenizer.
    ;

// 2. Structs, Unions, Enums, and Modifiers
pub const Payload = union.c_abi {
    byte: u8,
    word: u32 align(4),
    pointer: *const allowzero u8,
};

const State = enum(u8) {
    Idle,
    Running,
    Fault,
};

pub const Registers = struct.packed {
    ra: u32 = 0,
    sp: u32 align(16) = 0x80000000,
    state: State = .Idle,
    
    // Nested declarations inside structs
    pub const read_ra = fn(self: *Registers) u32 {
        return self.ra;
    };
};

extern var _stack_start: u32;

// 3. Linksections, Functions, and Complex Type Chains
export linksection(".init") const kernel_entry = fn.naked(hart_id: u32, dtb_ptr: ~const u8) !void {
    // 4. Variables, Anonymous Init, and Error Types
    var current_state: State = .Running;
    var regs: Registers = .{ .ra = 0, .sp = _stack_start, .state = current_state, };
    
    // 5. Defer and Errdefer (with assignment statements)
    defer current_state = .Idle;
    errdefer current_state = .Fault;

    // 6. Arithmetic, Bitwise, and Precedence Stress Test
    // (a + b) * c << d & e | f ^ g
    var complex_math = (10 + 5) * 2 << 4 & 0xFF | 0x01 ^ 0x02;
    complex_math += 1;
    complex_math %= 2;

    // 7. Arrays, Slices, and Pointers
    const my_array: [5]u8 = .{ .a = 1, .b = 2, .c = 3, .d = 4, .e = 5, };
    const my_slice: []const u8 = my_array[1..4];
    
    // 8. For Loops with Pointer and Index Captures
    for (my_slice) |*val, index| {
        // Postfix dereference (.*) and function calls mixed with math
        val.* = val.* + @cast(u8, index);
    }

    // 9. While loops, If/Else, Break, and Continue
    var counter: u32 = 0;
    while (counter < 100) {
        counter += 1;
        if (counter == 42) {
            continue;
        } else if (counter == 99) {
            break;
        } else {
            counter = counter | (1 << 2);
        }
    }

    // 10. Switch Statements with Ranges and Blocks
    const result = switch (counter) {
        0..10 => 100,
        11, 12, 13 => 200,
        42 => {
            const temp = 500;
            temp * 2; // Implicit block return
        },
        else => unreachable,
    };

    // 11. Volatile Memory Access (.~)
    var mmio_uart: ~u32 = @intToPtr(~u32, 0x10000000);
    mmio_uart.~ = 'A'; // Write char literal

    // 12. Optionals, Errors, Unwraps, and Coalescing
    const opt_val: ?u32 = null;
    const unwrapped = opt_val.? + 10;
    
    const err_val: !u32 = error.HardwareFault;
    const safe_val = err_val catch 0;
    const orelse_val = opt_val orelse 55;

    // 13. Inline Assembly (Volatile, Operands, Clobbers)
    asm {
        "csrr %[ret], mhartid"
        : [ret] "=r" (hart_id)
        : "memory", "t0"
    };

    return;
};

// 14. Alternative Function Modifier
pub const trap_vector = fn.interrupt(cause: u32 align(4), epc: u32) void {
    asm.pure {
        "wfi"
    };
};
